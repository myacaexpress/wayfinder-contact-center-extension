{
  "manifest_version": 3,
  "name": "Wayfinder Call Protection",
  "version": "0.3.11",
  "description": "Automatically pause the other calling system while busy in AllCalls or Wayfinder. No audio or recording access.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://allcalls.io/*",
    "https://wayfindercontactcenter.com/*",
    "https://www.wayfindercontactcenter.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://allcalls.io/take-calls*"
      ],
      "js": [
        "detector.js",
        "allcalls.js"
      ]
    },
    {
      "matches": [
        "https://wayfindercontactcenter.com/*",
        "https://www.wayfindercontactcenter.com/*"
      ],
      "js": [
        "wayfinder.js",
        "integrity-verify-wayfinder.js",
        "integrity-health-wayfinder.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": [
    "https://www.uhc.com/*",
    "http://127.0.0.1/*",
    "https://connect.integrity.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "integrity-verify.mjs",
        "integrity-health.mjs"
      ],
      "matches": [
        "https://connect.integrity.com/*"
      ]
    }
  ]
}
